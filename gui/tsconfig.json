{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"paths": {
			"#gui/*": ["./src/*"],
			"#i18n/*": ["./i18n/*"],
			"#petquery/*.js": ["../src/pet/query/*.ts"],
			"#schema/*.js": ["../schema/*.ts"],
			"@petquery/api-client": [
				"../packages/api-client/src/index.ts"
			]
		},
		"jsx": "react-jsx",
		"types": ["vite/client"],
		"strict": true,
		"noImplicitAny": true,
		"noImplicitOverride": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["src", "vite.config.ts", "../types/index.d.ts"]
}
