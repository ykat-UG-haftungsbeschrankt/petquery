{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"#gui/*": ["./src/*"],
			"#i18n/*": ["./i18n/*"],
			"#petquery/*.js": ["../src/pet/query/*.ts"],
			"#schema/*.js": ["../schema/*.ts"],
			"@petquery/api-client": [
				"../packages/api-client/src/index.ts"
			]
		},
		"types": ["node", "vite/client"]
	},
	"include": [
		"../src/**/*.ts",
		"../schema/**/*.ts",
		"../packages/api-client/src/**/*.ts",
		"../types/**/*.d.ts",
		"./src/**/*.ts",
		"./src/**/*.tsx",
		"./i18n/**/*.ts"
	],
	"exclude": [
		"../dist",
		"node_modules",
		"../node_modules",
		"**/.trash/**"
	]
}
