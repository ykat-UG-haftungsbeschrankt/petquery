{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"paths": {
			"#petquery/*.js": ["../../src/pet/query/*.ts"],
			"#schema/*.js": ["../../schema/*.ts"]
		},
		"strict": true,
		"noImplicitAny": true,
		"noImplicitOverride": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["src", "../../types/index.d.ts"]
}
