{
	"compilerOptions": {
		"target": "ESNext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"#petquery/*.js": ["./src/pet/query/*.ts"],
			"#schema/*.js": ["./schema/*.ts"]
		},
		"rootDir": ".",
		"outDir": "dist",
		"sourceMap": true,
		"lib": ["ESNext"],
		"types": ["node"],
		"strict": true,
		"noImplicitAny": true,
		"noImplicitOverride": true,
		"noEmitOnError": true,
		"skipLibCheck": true
	},
	"include": [
		"index.ts",
		"src/**/*.ts",
		"client/**/*.ts",
		"schema/**/*.ts",
		"examples/**/*.ts",
		"types/**/*.d.ts"
	],
	"exclude": ["node_modules", "dist", "**/.trash/*"]
}
