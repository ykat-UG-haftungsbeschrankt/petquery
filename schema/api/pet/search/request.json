{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"required": ["query"],
	"properties": {
		"query": {
			"type": "string",
			"minLength": 1,
			"pattern": "\\S"
		},
		"files": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["filename", "mime", "size", "data", "md5"],
				"properties": {
					"filename": {"type": "string"},
					"mime": {"type": "string"},
					"size": {"type": "number", "min": 0},
					"data": {"type": "string"},
					"md5": {"type": "string"}
				},
				"additionalProperties": false,
				"title": "GET /api/config/get File"
			}
		},
		"tracerouteUuid": {
			"type": "array",
			"items": {"type": "string", "format": "uuid"}
		}
	},
	"title": "POST /api/pets/search request",
	"additionalProperties": true
}
