{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"required": [
		"gid",
		"uri"
	],
	"properties": {
		"gid": {
			"type": "string",
			"format": "uuid"
		},
		"uri": {
			"type": "string",
			"format": "uri",
			"maxLength": 2048
		},
		"adminContact": {
			"type": "string",
			"maxLength": 1024
		},
		"companyAddress": {
			"type": "string",
			"maxLength": 4096
		}
	},
	"title": "PUT /api/server/put/:gid request"
}
