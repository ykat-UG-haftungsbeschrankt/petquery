{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"required": [
		"gid",
		"http",
		"authenticate",
		"file",
		"max_results_per_module",
		"max_results_total",
		"index",
		"route"
	],
	"properties": {
		"gid": {
			"type": "string",
			"format": "uuid"
		},
		"api": {
			"type": "object",
			"required": [
				"endpoint"
			],
			"properties": {
				"endpoint": {
					"type": "string",
					"format": "uri"
				}
			},
			"additionalProperties": false
		},
		"adminContact": {
			"type": "string",
			"maxLength": 1024
		},
		"companyAddress": {
			"type": "string",
			"maxLength": 4096
		},
		"http": {
			"type": "object",
			"required": [
				"port"
			],
			"properties": {
				"host": {
					"type": "string",
					"minLength": 1,
					"maxLength": 255
				},
				"port": {
					"type": "integer",
					"minimum": 1,
					"maximum": 65535
				},
				"enabled": {
					"type": "boolean"
				},
				"trusted_proxies": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1,
						"maxLength": 64
					},
					"maxItems": 64,
					"uniqueItems": true
				}
			},
			"additionalProperties": false
		},
		"https": {
			"type": "object",
			"required": [
				"port",
				"enabled",
				"certificate"
			],
			"properties": {
				"host": {
					"type": "string",
					"minLength": 1,
					"maxLength": 255
				},
				"port": {
					"type": "integer",
					"minimum": 1,
					"maximum": 65535
				},
				"enabled": {
					"type": "boolean"
				},
				"certificate": {
					"type": "object",
					"properties": {
						"key": {
							"type": "string"
						},
						"cert": {
							"type": "string"
						}
					},
					"additionalProperties": false
				}
			},
			"additionalProperties": false
		},
		"authenticate": {
			"type": "object",
			"required": [
				"mode",
				"session",
				"lmdb",
				"ldap",
				"oidc"
			],
			"properties": {
				"mode": {
					"type": "string",
					"minLength": 1
				},
				"providers": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"minItems": 1,
					"maxItems": 1000
				},
				"plugin_options": {
					"type": "object",
					"patternProperties": {
						"^.*$": {}
					}
				},
				"bearer": {
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^[\\x21-\\x7e]{16,256}$"
					},
					"minItems": 0,
					"maxItems": 100
				},
				"bearer_env": {
					"type": "string",
					"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
				},
				"session": {
					"type": "object",
					"required": [
						"cookie_name",
						"max_age",
						"secure"
					],
					"properties": {
						"cookie_name": {
							"type": "string",
							"pattern": "^[A-Za-z0-9._-]{1,64}$"
						},
						"max_age": {
							"type": "integer",
							"minimum": 60000,
							"maximum": 2147483647
						},
						"secure": {
							"type": "boolean"
						}
					},
					"additionalProperties": false
				},
				"lmdb": {
					"type": "object",
					"required": [
						"users_name",
						"sessions_name"
					],
					"properties": {
						"users_name": {
							"type": "string",
							"minLength": 1,
							"maxLength": 128
						},
						"sessions_name": {
							"type": "string",
							"minLength": 1,
							"maxLength": 128
						}
					},
					"additionalProperties": false
				},
				"ldap": {
					"type": "object",
					"required": [
						"url",
						"bind_dn",
						"bind_password",
						"base_dn",
						"user_filter",
						"admin_group"
					],
					"properties": {
						"url": {
							"type": "string",
							"maxLength": 4096
						},
						"bind_dn": {
							"type": "string",
							"maxLength": 4096
						},
						"bind_password": {
							"type": "string",
							"maxLength": 4096
						},
						"base_dn": {
							"type": "string",
							"maxLength": 4096
						},
						"user_filter": {
							"type": "string",
							"maxLength": 4096
						},
						"admin_group": {
							"type": "string",
							"maxLength": 1024
						}
					},
					"additionalProperties": false
				},
				"oidc": {
					"type": "object",
					"required": [
						"issuer",
						"client_id",
						"client_secret",
						"redirect_uri",
						"scopes",
						"admin_group"
					],
					"properties": {
						"issuer": {
							"type": "string",
							"maxLength": 4096
						},
						"client_id": {
							"type": "string",
							"maxLength": 1024
						},
						"client_secret": {
							"type": "string",
							"maxLength": 4096
						},
						"redirect_uri": {
							"type": "string",
							"maxLength": 4096
						},
						"scopes": {
							"type": "string",
							"maxLength": 1024
						},
						"admin_group": {
							"type": "string",
							"maxLength": 1024
						}
					},
					"additionalProperties": false
				}
			},
			"additionalProperties": false
		},
		"file": {
			"type": "object",
			"required": [
				"upload"
			],
			"properties": {
				"upload": {
					"type": "object",
					"required": [
						"enabled",
						"max_file_size"
					],
					"properties": {
						"enabled": {
							"type": "boolean"
						},
						"max_file_size": {
							"type": "integer",
							"minimum": 1,
							"maximum": 1073741824
						}
					},
					"additionalProperties": false
				}
			},
			"additionalProperties": false
		},
		"max_results_per_module": {
			"type": "integer",
			"minimum": 1,
			"maximum": 1000000
		},
		"max_results_total": {
			"type": "integer",
			"minimum": 1,
			"maximum": 1000000
		},
		"index": {
			"type": "object",
			"required": [
				"sync"
			],
			"properties": {
				"sync": {
					"type": "object",
					"required": [
						"enabled",
						"interval",
						"timeout",
						"max_servers"
					],
					"properties": {
						"enabled": {
							"type": "boolean"
						},
						"interval": {
							"type": "integer",
							"minimum": 1000,
							"maximum": 2147483647
						},
						"timeout": {
							"type": "integer",
							"minimum": 100,
							"maximum": 2147483647
						},
						"max_servers": {
							"type": "integer",
							"minimum": 1,
							"maximum": 1000000
						}
					},
					"additionalProperties": false
				}
			},
			"additionalProperties": false
		},
		"logging": {
			"type": "object",
			"properties": {
				"level": {
					"anyOf": [
						{
							"type": "string",
							"const": "error"
						},
						{
							"type": "string",
							"const": "warn"
						},
						{
							"type": "string",
							"const": "info"
						},
						{
							"type": "string",
							"const": "debug"
						}
					]
				},
				"request": {
					"type": "object",
					"properties": {
						"enabled": {
							"type": "boolean"
						}
					},
					"additionalProperties": false
				},
				"file": {
					"type": "object",
					"properties": {
						"path": {
							"type": "string",
							"minLength": 1,
							"maxLength": 4096
						},
						"max_size": {
							"type": "integer",
							"minimum": 1024,
							"maximum": 10485760
						},
						"max_files": {
							"type": "integer",
							"minimum": 2,
							"maximum": 5
						}
					},
					"additionalProperties": false
				}
			},
			"additionalProperties": false
		},
		"database": {
			"anyOf": [
				{
					"type": "object",
					"required": [
						"type",
						"connectionString"
					],
					"properties": {
						"type": {
							"type": "string",
							"const": "postgresql"
						},
						"connectionString": {
							"type": "string",
							"minLength": 1
						}
					},
					"additionalProperties": false
				},
				{
					"type": "object",
					"required": [
						"type",
						"path"
					],
					"properties": {
						"type": {
							"type": "string",
							"const": "lmdb"
						},
						"path": {
							"type": "string",
							"minLength": 1
						}
					},
					"additionalProperties": false
				}
			]
		},
		"ai_search_path": {
			"type": "string",
			"minLength": 1
		},
		"route": {
			"type": "object",
			"required": [
				"api"
			],
			"properties": {
				"api": {
					"type": "object",
					"required": [
						"enabled",
						"plugins"
					],
					"properties": {
						"enabled": {
							"type": "boolean"
						},
						"plugins": {
							"type": "array",
							"items": {
								"type": "string",
								"minLength": 1
							},
							"maxItems": 1000
						}
					},
					"additionalProperties": false
				}
			},
			"additionalProperties": false
		}
	},
	"additionalProperties": false
}
