{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"required": [
		"params",
		"query",
		"body"
	],
	"properties": {
		"params": {
			"type": "object",
			"properties": {}
		},
		"query": {
			"type": "object",
			"properties": {
				"query": {
					"type": "string"
				},
				"bearer": {
					"type": "string"
				},
				"iframe": {
					"anyOf": [
						{
							"type": "string",
							"const": "true"
						},
						{
							"type": "string",
							"const": "false"
						}
					]
				},
				"tracerouteUuid": {
					"anyOf": [
						{
							"type": "string",
							"format": "uuid"
						},
						{
							"type": "array",
							"items": {
								"type": "string",
								"format": "uuid"
							},
							"maxItems": 1000
						}
					]
				}
			}
		},
		"body": {
			"type": "object",
			"properties": {
				"query": {
					"type": "string"
				},
				"bearer": {
					"type": "string"
				},
				"iframe": {
					"type": "boolean"
				},
				"tracerouteUuid": {
					"type": "array",
					"items": {
						"type": "string",
						"format": "uuid"
					},
					"maxItems": 1000
				}
			}
		}
	},
	"title": "Search request of /api and /json"
}
