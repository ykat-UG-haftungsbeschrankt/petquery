{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"query": {
			"type": "string"
		},
		"bearer": {
			"type": "string"
		},
		"iframe": {
			"anyOf": [
				{
					"type": "boolean"
				},
				{
					"type": "string",
					"const": "true"
				},
				{
					"type": "string",
					"const": "false"
				}
			]
		},
		"tracerouteUuid": {
			"anyOf": [
				{
					"type": "string",
					"format": "uuid"
				},
				{
					"type": "array",
					"items": {
						"type": "string",
						"format": "uuid"
					},
					"maxItems": 1000
				}
			]
		}
	},
	"title": "Search request of /api and /json"
}
