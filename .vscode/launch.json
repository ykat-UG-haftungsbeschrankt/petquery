{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch PetQuery",
            "program": "${workspaceFolder}/dist/index.js",
            "args": [
                "--config",
                "${workspaceFolder}/config/debug/server-`date +%Y%m%d-%H%M`.json",
				"--port",
                "50101"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "npm: build",
            "serverReadyAction": {
                "pattern": "Express App running at (https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            },
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Bootstrap PetQuery",
            "program": "${workspaceFolder}/dist/index.js",
            "args": [
                "--config",
                "${workspaceFolder}/config/debug/bootstrap.json",
                "--port",
                "50101"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "npm: build:server",
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Generate and Open Docs",
            "program": "${workspaceFolder}/node_modules/typedoc/bin/typedoc",
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "outputCapture": "std",
            "serverReadyAction": {
                "pattern": "html generated at",
                "uriFormat": "file://${workspaceFolder}/gui/public/typedoc/index.html",
                "action": "openExternally"
            },
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}