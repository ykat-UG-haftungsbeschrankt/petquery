{
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"imports": {
		"#petquery/*.js": {
			"types": "./src/pet/query/*.ts",
			"default": "./dist/src/pet/query/*.js"
		},
		"#schema/*.js": {
			"types": "./schema/*.ts",
			"default": "./dist/schema/*.js"
		}
	},
	"scripts": {
		"build": "eslint . && tsc --project tsconfig.json && npm run build:schema && npm run build:gui",
		"build:server": "tsc --project tsconfig.json",
		"build:schema": "node dist/schema/build.js",
		"build:gui": "npm --prefix gui run build",
		"debug:multi": "sh scripts/debug-multi.sh",
		"dev:gui": "npm --prefix gui run dev",
		"install:gui": "npm --prefix gui ci",
		"lint": "eslint .",
		"doc": "typedoc --options typedoc.json",
		"start": "npm run build && node dist/index.js"
	},
	"dependencies": {
		"@huggingface/transformers": "^3.8.1",
		"better-sqlite3": "^12.11.1",
		"cast.ts": "^1.20.0",
		"express": "^5.2.1",
		"express-fileupload": "^1.5.2",
		"hnswlib-node": "^3.0.0",
		"ldapts": "^8.2.0",
		"lmdb": "^3.5.7",
		"mongodb": "^6.20.0",
		"mysql2": "^3.24.5",
		"mysql2-async": "^2.0.5",
		"openid-client": "^6.8.8",
		"pg": "^8.23.1",
		"sharp": "^0.35.5",
		"typebox": "^1.3.36",
		"uuid": "^14.0.3"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^9.6.0",
		"@types/express": "^5.0.6",
		"@types/express-fileupload": "^1.5.1",
		"@types/node": "^22.15.30",
		"@types/pg": "^8.23.1",
		"@typhonjs-typedoc/typedoc-theme-dmt": "^0.4.0",
		"eslint": "^10.12.0",
		"typedoc": "^0.28.20",
		"typedoc-plugin-inline-sources": "^1.3.0",
		"typedoc-plugin-markdown": "^4.13.1",
		"typedoc-plugin-mermaid": "^1.12.0",
		"typedoc-umlclass": "^0.10.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.1"
	}
}
