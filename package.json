{
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"imports": {
		"#petquery/*.js": "./dist/src/pet/query/*.js",
		"#schema/*.js": "./dist/schema/*.js"
	},
	"scripts": {
		"build": "eslint . && tsc --project tsconfig.json && npm run build:schema && npm run build:gui",
		"build:schema": "node dist/schema/build.js",
		"build:gui": "npm --prefix gui run build",
		"dev:gui": "npm --prefix gui run dev",
		"install:gui": "npm --prefix gui ci",
		"lint": "eslint .",
		"doc": "typedoc",
		"start": "npm run build && node dist/index.js"
	},
	"dependencies": {
		"cast.ts": "^1.20.0",
		"express": "^5.2.1",
		"express-fileupload": "^1.5.2",
		"lmdb": "^3.5.7",
		"mongodb": "^6.20.0",
		"mysql2": "^3.24.5",
		"mysql2-async": "^2.0.5",
		"typebox": "^1.3.36",
		"uuid": "^14.0.3"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/express-fileupload": "^1.5.1",
		"@types/node": "^22.15.30",
		"eslint": "^10.12.0",
		"typedoc": "^0.28.20",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.1"
	}
}
